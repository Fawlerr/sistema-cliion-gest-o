{
  "name": "clinic-dashboard-demo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --prefix frontend",
    "dev:front": "npm run dev --prefix frontend",
    "dev:django": "cd admin-django && venv\\Scripts\\python manage.py runserver 8000",
    "dev": "concurrently -c \"cyan,magenta\" -n \"REACT,DJANGO\" \"npm run dev:front\" \"npm run dev:django\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^7.6.0"
  },
  "dependencies": {
    "git": "^0.1.5",
    "pg": "^8.20.0",
    "@prisma/adapter-pg": "^7.6.0"
  }
}
